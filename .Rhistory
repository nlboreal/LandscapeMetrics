library(landscapemetrics)
library(raster)
knitr::opts_chunk$set(echo = TRUE)
augusta <- terra::rast(landscapemetrics::landscape)
plot(augusta)
lsm_c_area_mn(augusta) #mean area of all patches by class
lsm_c_area_sd(augusta) #stand deviation of area of all patches by class
lsm_c_enn_mn(augusta) #mean Euclidean nearest neighbour distance of all patches by class
lsm_c_frac_cv(augusta) #coefficient of variation of fractal dimension of all patches by class
